{
  "name": "cinematic-chapters",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "db:local": "tsx scripts/postgres.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "admin:create": "tsx scripts/admin.ts",
    "worker": "tsx scripts/worker.ts",
    "setup:local": "tsx scripts/setup.ts",
    "test": "tsx scripts/test.ts",
    "test:browser": "tsx scripts/browser-test.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write app components lib scripts tests e2e *.ts *.json *.yaml docs README.md"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1146.0",
    "archiver": "8.0.0",
    "better-auth": "1.7.7",
