DATABASE_URL=postgresql://chapters:REPLACE_LOCAL_PASSWORD@127.0.0.1:55432/chapters
BETTER_AUTH_URL=http://127.0.0.1:3000
BETTER_AUTH_SECRET=REPLACE_WITH_32_BYTE_RANDOM_SECRET
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=.data/objects
STORAGE_ALLOWANCE_BYTES=10737418240
# S3 bucket must be private. MinIO is provided in compose.yaml.
S3_ENDPOINT=
S3_REGION=eu-west-2
S3_BUCKET=chapters-private
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
EMAIL_DRIVER=preview
EMAIL_FROM=Cinematic Chapters <studio@example.invalid>
SMTP_HOST=
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
# Explicit opt-in required for external message delivery.
ALLOW_EXTERNAL_MESSAGES=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_USER_IDS=
TELEGRAM_WEBHOOK_SECRET=
