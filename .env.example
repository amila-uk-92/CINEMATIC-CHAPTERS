# Application Environment Configuration
# Default is configured for immediate local run without third-party accounts.

PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# PostgreSQL Configuration
# If DATABASE_URL is left empty or not set, PGlite is automatically used in ./data/pglite-db
# To connect to external Postgres: postgres://user:password@localhost:5432/cinematic_chapters
DATABASE_URL=

# Storage Configuration
# If S3 credentials are empty, the local storage adapter writes directly to ./public/uploads and ./data/private-storage
STORAGE_DRIVER=local
STORAGE_CAPACITY_BYTES=53687091200 # 50 GB allowance
# S3_ENDPOINT=https://s3.eu-west-2.amazonaws.com
# S3_REGION=eu-west-2
# S3_BUCKET=cinematic-chapters-storage
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Authentication Session Secret
SESSION_SECRET=dev-cinematic-chapters-secret-key-32-chars-min!

# First Admin Provisioning
# Run `npm run seed` to create this admin, or log in using these default seed credentials
INITIAL_ADMIN_EMAIL=admin@cinematicchapters.co.uk
INITIAL_ADMIN_PASSWORD=LeicesterStudio2026!

# Email Service Configuration
# Values: local | resend | smtp
# When set to 'local', emails are saved to the Outbox table and viewable in the Admin Email Inspector
EMAIL_DRIVER=local
EMAIL_FROM=hello@cinematicchapters.co.uk
# RESEND_API_KEY=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# Telegram Website Chat Integration
# If not configured, the website chat displays an honest fallback contact notice.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
